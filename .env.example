# ===== Binance =====
# Use READ-ONLY scope keys whenever possible.
# Only the exchange-trading-executor needs trade scope, and even then NEVER enable withdraw.
BINANCE_API_KEY=your_binance_key_here
BINANCE_API_SECRET=your_binance_secret_here
BINANCE_RECV_WINDOW=5000

# ===== OKX =====
# OKX requires THREE values: key, secret, passphrase.
OKX_API_KEY=your_okx_key_here
OKX_API_SECRET=your_okx_secret_here
OKX_API_PASSPHRASE=your_okx_passphrase_here

# ===== Operational =====
# Path where the suite stores persistent state (watchlists, paper ledger, blacklists).
CRYPTO_SKILLS_HOME=~/.crypto-skills

# Default mode for the trading-executor skill.
# Allowed: dry_run | shadow | live
EXECUTOR_DEFAULT_MODE=dry_run

# Optional kill-switch file. If this file exists, executor refuses to submit.
KILL_SWITCH_PATH=~/.crypto-skills/KILLSWITCH

# Optional public sentiment proxy (used by crypto-sentiment-scan if include_social=true)
# Leave empty to skip the social component.
ALT_FEAR_GREED_URL=https://api.alternative.me/fng/

# Default risk profile used if user doesn't specify one
DEFAULT_RISK_PROFILE=balanced
