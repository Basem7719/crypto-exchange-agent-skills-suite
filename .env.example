# ===== Trading Mode =====
# Allowed: analysis_only | paper_trading | execution_ready
DEFAULT_MODE=analysis_only

# Safety flag — when true, no live orders are ever submitted
DRY_RUN=true

# ===== Position Limits =====
# Maximum notional size per single order in USDT (leave empty = no cap)
MAX_TRADE_USDT=

# Maximum allowable daily loss in USDT before kill-switch triggers (leave empty = no cap)
MAX_DAILY_LOSS_USDT=

# ===== Binance =====
# Use READ-ONLY scope keys whenever possible.
# Only exchange-trading-executor needs trade scope — NEVER enable withdraw permission.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW=5000
BINANCE_TESTNET=false

# ===== OKX =====
# OKX requires THREE values: key, secret, and passphrase.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_TESTNET=false

# ===== Operational =====
# Directory where the suite stores persistent state (watchlists, paper ledger, blacklists).
CRYPTO_SKILLS_HOME=~/.crypto-skills

# Kill-switch file path. If this file exists, executor refuses ALL live submissions.
KILL_SWITCH_PATH=~/.crypto-skills/KILLSWITCH

# Default risk profile used if user doesn't specify one.
# Allowed: conservative | balanced | aggressive
DEFAULT_RISK_PROFILE=balanced

# Optional public sentiment proxy (used by crypto-sentiment-scan if include_social=true).
# Leave empty to skip the social component.
ALT_FEAR_GREED_URL=https://api.alternative.me/fng/
