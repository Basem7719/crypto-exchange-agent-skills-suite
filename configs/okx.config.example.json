{
  "rest_base": "https://www.okx.com",
  "endpoints": {
    "public": {
      "instruments":     "/api/v5/public/instruments",
      "funding_rate":    "/api/v5/public/funding-rate",
      "funding_history": "/api/v5/public/funding-rate-history",
      "open_interest":   "/api/v5/public/open-interest",
      "system_status":   "/api/v5/system/status"
    },
    "market": {
      "ticker":         "/api/v5/market/ticker",
      "candles":        "/api/v5/market/candles",
      "history_candles":"/api/v5/market/history-candles",
      "books":          "/api/v5/market/books"
    },
    "rubik": {
      "ls_account_ratio": "/api/v5/rubik/stat/contracts/long-short-account-ratio",
      "taker_volume":     "/api/v5/rubik/stat/taker-volume",
      "open_interest_volume": "/api/v5/rubik/stat/contracts/open-interest-volume"
    },
    "account": {
      "balance":       "/api/v5/account/balance",
      "positions":     "/api/v5/account/positions",
      "subaccount_apikey": "/api/v5/users/subaccount/apikey"
    },
    "trade": {
      "new_order":     "/api/v5/trade/order",
      "cancel_order":  "/api/v5/trade/cancel-order",
      "order_info":    "/api/v5/trade/order",
      "open_orders":   "/api/v5/trade/orders-pending"
    }
  },
  "auth_headers": [
    "OK-ACCESS-KEY",
    "OK-ACCESS-SIGN",
    "OK-ACCESS-TIMESTAMP",
    "OK-ACCESS-PASSPHRASE"
  ],
  "signature": "BASE64(HMAC_SHA256(prehash, secret))",
  "prehash_format": "timestamp + method + requestPath + body",
  "bar_values": ["1m","3m","5m","15m","30m","1H","2H","4H","6H","12H","1D","1W","1M"]
}
